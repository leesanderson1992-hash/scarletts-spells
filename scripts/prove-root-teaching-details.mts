/** Read-only integration proof for reviewed root text, reference cards and target exclusion. */
import fs from'node:fs';import{parseEnv}from'node:util';import assert from'node:assert/strict';import pg from'pg';import{createClient}from'@supabase/supabase-js';import{loadRootOnlyWordIds}from'../lib/adle/loaders/root-only-entries';import{loadWordBaseFamilies}from'../lib/teaching-dictionary-manager/base-family-summary';import{loadCanonicalWordSkillRelationshipAuthority}from'../lib/adle/word-skill-relationships/repository';
const environment=process.argv[2] as "staging"|"production";assert(['staging','production'].includes(environment));const e=parseEnv(fs.readFileSync(environment==='staging'?'.env.staging.local':(process.env.ROOT_DETAILS_PRODUCTION_ENV_FILE||'.tmp/current-production.env'),'utf8'));const local=parseEnv(fs.readFileSync('.env.local','utf8'));Object.assign(process.env,e,{ADLE_ROUTE_ACTIVATION_ENVIRONMENT:environment});assert(e.NEXT_PUBLIC_SUPABASE_URL?.includes(environment==='staging'?'qkpjbajicacbrphthibk':'wwohrqtunajrbwxyssjf'));
const client=createClient(e.NEXT_PUBLIC_SUPABASE_URL!,e.SUPABASE_SERVICE_ROLE_KEY||e.SB_SERVICE_ROLE_KEY!,{auth:{persistSession:false,autoRefreshToken:false}});const db=new pg.Client({connectionString:environment==='staging'?e.SUPABASE_STAGING_DB_URL:local.SUPABASE_PRODUCTION_DB_URL_POOLER_SHARED,ssl:{rejectUnauthorized:false}});const plan=JSON.parse(fs.readFileSync('data/teaching-dictionary/root-teaching-details-2026-11-27.json','utf8'));await db.connect();try{await db.query('begin read only');const rows=(await db.query(`select distinct on(f.family_key) f.*,r.origin_language,r.teaching_examples,r.root_definition,s.sense_set,m.morphology_parts from teaching_dictionary_families_with_current_meaning f join canonical_teaching_dictionary_lexical_root_metadata r using(family_key,revision) join teaching_dictionary_reviewed_sense_sets s on s.canonical_word_id=f.canonical_base_word_id join teaching_dictionary_current_sense_morphology m on m.canonical_word_id=f.canonical_base_word_id and m.sense_id=f.canonical_base_sense_id where f.is_current_family and f.base_kind='bound_root' and f.review_status='approved' order by f.family_key,f.revision desc`)).rows;
const checked=[];for(const original of plan.roots){const policy=JSON.parse(fs.readFileSync('data/teaching-dictionary/root-language-policy-2026-11-27.json','utf8'));const expected={...original,origin:policy.originOverrides[original.root]??original.origin};const f=rows.find(f=>f.base_lemma===expected.root);assert(f);assert.equal(f.base_meaning,expected.meaning);assert.equal(f.origin_language,expected.origin);assert.deepEqual(f.teaching_examples,expected.examples);assert.equal(f.root_definition,expected.meaning);assert.equal(f.morphology_parts[0].gloss,expected.meaning);const cards=await loadWordBaseFamilies(client,f.canonical_base_word_id);const card=cards.find(c=>c.name===f.family_key);assert(card,expected.root+' family missing');assert.equal(card.baseSenseId,f.canonical_base_sense_id);assert.equal(card.meaning,expected.meaning);assert.equal(card.rootOrigin,expected.origin);assert.deepEqual(card.rootExamples,expected.examples);checked.push({root:expected.root,origin:card.rootOrigin,meaning:card.meaning,examples:card.rootExamples,wordId:f.canonical_base_word_id,senseId:f.canonical_base_sense_id});}
const rootOnly=await loadRootOnlyWordIds(client);if(environment==='production')assert.equal(rootOnly.size,35);const authority=await loadCanonicalWordSkillRelationshipAuthority({client,environmentKey:environment,canonicalWordIds:[...rootOnly]});assert.equal(authority.relationships.length,0);assert.equal((await db.query("select count(*)::int count from adle_learning_items where canonical_word_id=any($1::uuid[]) and row_status='active'",[[...rootOnly]])).rows[0].count,0);const port=rows.find(f=>f.base_lemma==='port');assert(!rootOnly.has(port.canonical_base_word_id));const report={environment,readOnly:true,checked,rootOnlyEntries:rootOnly.size,ordinaryRootRelationshipsAdmitted:0,activeRootOnlyLearningItems:0,portOrdinaryMeaningPreserved:true};fs.writeFileSync(`outputs/root-teaching-details-20261127/${environment}-verification.json`,JSON.stringify(report,null,2));console.log({environment,verifiedRootCards:checked.length,rootOnlyRelationships:0,rootOnlyTargets:0,portOrdinaryMeaningPreserved:true});await db.query('rollback');}finally{await db.end()}
