/** Read-only Production export using the same data projection and workbook builder as the admin endpoint. */
import fs from 'node:fs';import assert from 'node:assert/strict';import {parseEnv} from 'node:util';import pg from 'pg';import type {SupabaseClient} from '@supabase/supabase-js';
import {latinRootWorkbookData} from '../lib/teaching-dictionary-manager/latin-root-bulk-review';import {buildReviewWorkbook} from '../lib/teaching-dictionary-manager/review-workbook';
const env=parseEnv(fs.readFileSync('.env.local','utf8'));const url=env.SUPABASE_PRODUCTION_DB_URL_POOLER_SHARED;assert(new URL(url).username.endsWith('.wwohrqtunajrbwxyssjf'));Object.assign(process.env,{NEXT_PUBLIC_SUPABASE_URL:'https://wwohrqtunajrbwxyssjf.supabase.co',ADLE_ROUTE_ACTIVATION_ENVIRONMENT:'production'});
const sql=new pg.Client({connectionString:url,ssl:{rejectUnauthorized:false},connectionTimeoutMillis:10000});await sql.connect();
const tables=new Set(['teaching_dictionary_root_skill_families','teaching_dictionary_root_language_assignments','teaching_dictionary_lesson_review_requests','adle_route_activation_heads','teaching_dictionary_effective_lesson_sense_bindings','teaching_dictionary_pair_latest_decisions','teaching_dictionary_bulk_review_exclusions','canonical_teaching_dictionary_words','teaching_dictionary_reviewed_sense_sets','teaching_dictionary_current_sense_morphology','teaching_dictionary_current_sense_family_memberships','teaching_dictionary_families_with_current_meaning','adle_route_activation_revisions','adle_curriculum_release_manifests','adle_curriculum_release_dependencies','adle_curriculum_dependency_authorities']);
const identifier=(name:string)=>{assert(/^[a-z_]+$/.test(name));return '"'+name+'"';};
function from(table:string){assert(tables.has(table));let columns='*',single=false;const where:string[]=[],order:string[]=[],args:unknown[]=[];let limit=1001;
 const query={select(value:string){columns=value.split(',').map(identifier).join(',');return query;},eq(key:string,value:unknown){args.push(value);where.push(`${identifier(key)}=$${args.length}`);return query;},in(key:string,value:unknown[]){args.push(value);where.push(`${identifier(key)}=any($${args.length})`);return query;},order(key:string,options?:{ascending?:boolean}){order.push(identifier(key)+(options?.ascending===false?' desc':' asc'));return query;},maybeSingle(){single=true;return query;},single(){single=true;return query;},limit(n:number){assert(Number.isInteger(n)&&n>0);limit=n;return query;},then(resolve:(r:unknown)=>unknown,reject:(e:unknown)=>unknown){const text=`select to_jsonb(export_row) as row from(select ${columns} from public.${identifier(table)}${where.length?' where '+where.join(' and '):''}${order.length?' order by '+order.join(','):''} limit ${limit}) export_row`;return sql.query(text,args).then(result=>{const rows=result.rows.map(r=>r.row);assert(!single||rows.length<=1);return {data:single?rows[0]??null:rows,error:null};}).then(resolve,reject);}};return query;
}
try{await sql.query('begin read only');const data=await latinRootWorkbookData({from} as unknown as SupabaseClient);const bytes=await buildReviewWorkbook(data);const dir='outputs/latin-root-bulk-workflow-20261127';fs.mkdirSync(dir,{recursive:true});const path=dir+'/Common-Latin-roots-review.xlsx';fs.writeFileSync(path,Buffer.from(bytes));const report={environment:'production',readOnly:true,words:data.bundles.length,meaningRows:data.bundles.reduce((n,b)=>n+b.senseSet.senses.length,0),ready:data.rows.filter(r=>r.ready).length,published:data.current.length,needInformation:data.rows.filter(r=>!r.ready).length,wordNames:data.rows.map(r=>r.word),path};fs.writeFileSync(dir+'/production-export.json',JSON.stringify(report,null,2));console.log(report);await sql.query('rollback');}finally{await sql.end()}
