import fs from 'node:fs';import assert from 'node:assert/strict';import {parseEnv} from 'node:util';import pg from 'pg';import {createHash} from 'node:crypto';
const e=parseEnv(fs.readFileSync('.env.staging.local','utf8'));const d=new pg.Client({connectionString:e.SUPABASE_STAGING_DB_URL,ssl:{rejectUnauthorized:false}});await d.connect();try{await d.query('begin');const preview=JSON.parse(fs.readFileSync('outputs/latin-root-bulk-workflow-20261127/staging-preview.json','utf8'));const closure=preview.pkg.authorities.find((a:{authorityType:string})=>a.authorityType==='teaching_dictionary_closure').semanticProjection;
assert.equal((await d.query('select adle_latin_root_reviewed_subset_current_v1($1) ok',[closure])).rows[0].ok,true);
const head=(await d.query("select current_revision_id from adle_route_activation_heads where environment_key='staging' and route_id='latin_root_word_lab' and micro_skill_key='D4_MOR_ROOTS_COMMON_LATIN_ROOTS'" )).rows[0].current_revision_id;
const initialHead=head;
for(const kind of ['sense','source','origin']){const bad=structuredClone(closure);if(kind==='sense')bad.teachingSenseBindings[bad.dictionary.words[0].canonicalWordId]='forged';if(kind==='source')bad.dictionary.words[0].word='forged';if(kind==='origin')bad.dictionary.families[0].origin='Greek';assert.equal((await d.query('select adle_latin_root_reviewed_subset_current_v1($1) ok',[bad])).rows[0].ok,false,kind);}
await d.query('savepoint veto');await d.query("insert into teaching_dictionary_bulk_review_exclusions(environment_key,micro_skill_key,canonical_word_id,reviewed_by) values('staging','D4_MOR_ROOTS_COMMON_LATIN_ROOTS',$1,$2) on conflict do nothing",[closure.dictionary.words[0].canonicalWordId,e.STAGING_ADMIN_USER_ID]);assert.equal((await d.query('select adle_latin_root_reviewed_subset_current_v1($1) ok',[closure])).rows[0].ok,false);await d.query('rollback to savepoint veto');
await d.query('savepoint stale');let rejected=false;try{await d.query("select publish_adle_latin_root_bulk_review_v1($1,$2,'staging','00000000-0000-0000-0000-000000000000',$3)",[preview.pkg,createHash('sha256').update(JSON.stringify(preview.pkg)).digest('hex'),e.STAGING_ADMIN_USER_ID]);}catch{rejected=true;}await d.query('rollback to savepoint stale');assert(rejected);assert.equal((await d.query("select current_revision_id from adle_route_activation_heads where environment_key='staging' and route_id='latin_root_word_lab' and micro_skill_key='D4_MOR_ROOTS_COMMON_LATIN_ROOTS'")).rows[0].current_revision_id,initialHead);
const result=(await d.query('select publish_adle_latin_root_bulk_review_v1($1,$2,\'staging\',$3,$4) result',[preview.pkg,createHash('sha256').update(JSON.stringify(preview.pkg)).digest('hex'),head,e.STAGING_ADMIN_USER_ID])).rows[0].result;assert.equal(result.wordCount,preview.wordCount);console.log({stagingPublisher:true,wordCount:result.wordCount,rollback:true,forgedSenseRejected:true,changedSourceRejected:true,wrongOriginRejected:true,vetoRespected:true,staleHeadRejected:true});await d.query('rollback');}catch(e){await d.query('rollback');throw e;}finally{await d.end()}
