    "introContent": {
      "title": "What is the suffix -ment?",
      "meaningStatement": "-ment turns something you do into the name of the action or result.",
      "paragraphs": [
        "A suffix is added to the end of a base or root.",
        "The suffix -ment is a noun maker. We can take a verb like enjoy and, when we add -ment to the end, it turns it into a noun."
      ],
      "spellingRules": [
        "Spell the suffix m-e-n-t, even when its vowel is difficult to hear.",
        "In these lesson words, keep the whole base before adding -ment.",
        "Keep the final e in agree + ment → agreement and move + ment → movement."
      ],
      "examples": [
        {
          "affix": "ment",
          "base": "enjoy",
          "word": "enjoyment",
          "meaning": "the feeling or process of enjoying"
        },
        {
          "affix": "ment",
          "base": "move",
          "word": "movement",
          "meaning": "the action or process of moving"
        }
      ]
    },
    "reflection": {
      "promptKey": "ment-base-preservation-v1",
      "promptText": "How did keeping the whole base and adding -ment help you spell and understand the new word?"
    }
  },
