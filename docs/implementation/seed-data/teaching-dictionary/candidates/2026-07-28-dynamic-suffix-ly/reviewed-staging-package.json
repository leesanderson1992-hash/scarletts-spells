    "introContent": {
      "title": "What is the suffix -ly?",
      "meaningStatement": "-ly tells us how something is done.",
      "paragraphs": [
        "A suffix is a group of letters added to the end of a word.",
        "The suffix -ly often means in a certain way. It usually changes a describing word into a word that tells us how something happens."
      ],
      "spellingRules": [
        "quick + ly → quickly; slow + ly → slowly; quiet + ly → quietly.",
        "happy → happi + ly: change y to i.",
        "gentle → gently and true → truly are examples of other spelling changes."
      ],
      "examples": [
        {
          "affix": "ly",
          "base": "quick",
          "word": "quickly",
          "meaning": "in a quick way"
        },
        {
          "affix": "ly",
          "base": "happy",
          "word": "happily",
          "meaning": "in a happy way"
        }
      ]
    },
