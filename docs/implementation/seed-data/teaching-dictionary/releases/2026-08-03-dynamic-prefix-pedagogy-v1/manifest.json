  "prefixDefinitions": [
    { "text": "un", "label": "un-", "meaning": "not, the opposite of, or reverse", "rules": ["Add un- to the beginning of a base word. Keep every letter in un- and in the base word."], "example": { "prefix": "un", "base": "happy", "word": "unhappy", "meaning": "not happy" } },
    { "text": "dis", "label": "dis-", "meaning": "not or the opposite", "rules": ["Add dis- to the beginning of a base word. Keep every letter in dis- and in the base word."], "example": { "prefix": "dis", "base": "agree", "word": "disagree", "meaning": "not having the same opinion" } },
    { "text": "mis", "label": "mis-", "meaning": "wrongly or badly", "rules": ["Add mis- to the beginning when something is done wrongly or badly. Keep the base word’s spelling."], "example": { "prefix": "mis", "base": "spell", "word": "misspell", "meaning": "spell wrongly" } },
    { "text": "in", "label": "in-", "meaning": "not", "rules": ["Use in- before most other letters."], "example": { "prefix": "in", "base": "visible", "word": "invisible", "meaning": "not able to be seen" } },
    { "text": "im", "label": "im-", "meaning": "not", "rules": ["Use im- before b, m or p."], "example": { "prefix": "im", "base": "possible", "word": "impossible", "meaning": "not able to happen or be done" } },
    { "text": "il", "label": "il-", "meaning": "not", "rules": ["Use il- before l."], "example": { "prefix": "il", "base": "legal", "word": "illegal", "meaning": "not allowed by law or rules" } },
    { "text": "ir", "label": "ir-", "meaning": "not", "rules": ["Use ir- before r."], "example": { "prefix": "ir", "base": "regular", "word": "irregular", "meaning": "not regular" } },
    { "text": "re", "label": "re-", "meaning": "again or back", "rules": ["Use re- at the beginning when the new word means again or back. Keep the base word’s spelling."], "example": { "prefix": "re", "base": "build", "word": "rebuild", "meaning": "build again" } },
    { "text": "pre", "label": "pre-", "meaning": "before", "rules": ["Use pre- at the beginning when the new word means before. Keep the base word’s spelling."], "example": { "prefix": "pre", "base": "view", "word": "preview", "meaning": "view before" } },
    { "text": "sub", "label": "sub-", "meaning": "under", "rules": ["Spell sub- as one fixed chunk at the beginning of the word."], "example": { "prefix": "sub", "base": "marine", "word": "submarine", "meaning": "a boat that travels under the sea" } },
    { "text": "inter", "label": "inter-", "meaning": "between", "rules": ["Spell inter- as one fixed chunk at the beginning of the word."], "example": { "prefix": "inter", "base": "national", "word": "international", "meaning": "involving more than one country" } },
    { "text": "super", "label": "super-", "meaning": "above or beyond", "rules": ["Spell super- as one fixed chunk at the beginning of the word."], "example": { "prefix": "super", "base": "hero", "word": "superhero", "meaning": "a hero with special powers" } }
  ],
