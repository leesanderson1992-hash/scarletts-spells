  "reviewedIntroduction": {
    "title": "Open and hyphenated compounds",
    "childFriendlyExplanation": "Some two-word teams stay apart (ice cream), and some hold hands with a hyphen (well-known). The words themselves stay perfectly spelled — the skill is knowing whether they're glued, hyphenated, or separate. Hyphenated compound: Join the words with a hyphen when they work together as one describing idea. Open compound: Leave a space when the two words belong together but are usually written separately.",
    "ruleExplanation": "Open compounds keep a space (ice cream, living room); hyphenated compounds join with - (twenty-one, part-time). Each word part keeps its full spelling.",
    "watchForCue": "Spell each word perfectly first; then ask — glued, hyphen, or space? Learn each team's style like a name.",
    "sourceApprovalStatus": "human_approved",
    "sourceReviewerDecision": "approved_with_amendment"
  },
  "reflection": {
    "promptKey": "compound-join-style-v1",
    "promptText": "What tells you whether compound parts need no gap, a space, or a hyphen?",
