  "reviewedIntroduction": {
    "title": "Common Greek roots",
    "childFriendlyExplanation": "The ancient Greeks gave us word-treasures too: tele = far (telephone, telescope), phon = sound, graph = write/draw, photo = light. Greek roots carry secret signs — ph says /f/, ch says /k/ — that mark a word as Greek.",
    "ruleExplanation": "Greek roots keep stable spelling and distinctive graphemes: phon (sound), graph (write), photo (light), tele (far), scope (look), micro (small). ph=/f/ and ch=/k/ signal Greek origin.",
    "watchForCue": "An /f/ in a science-y word is often the Greek sign ph — telephone, graph, photo. Spot the Greek treasure marks.",
    "sourceApprovalStatus": "human_approved",
    "sourceReviewerDecision": "approved"
  },
  "reflection": {
    "promptKey": "greek-root-meaning-v1",
    "promptText": "How did the Greek root meaning help you build or understand a word?",
