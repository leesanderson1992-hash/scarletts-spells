  "reviewedIntroduction": {
    "title": "Root families keep their spelling",
    "childFriendlyExplanation": "A root is the family surname — it's spelled the same on every family member. act: act, actor, action, active, react. The endings change, the sounds shift, but a-c-t never breaks.",
    "ruleExplanation": "Root spelling is invariant across derivatives: act/action/actor, medic/medical/medicine, sign/signal/signature. Anchor the root, then vary the affixes.",
    "watchForCue": "Learn the surname once — act, medic, sign — and trust it in every relative, whatever the ending sounds like.",
    "sourceApprovalStatus": "human_approved",
    "sourceReviewerDecision": "approved"
  },
  "reflection": {
