  "reviewedIntroduction": {
    "title": "Science and maths roots",
    "childFriendlyExplanation": "School subject words look scary until you see the bricks: thermometer = therm (heat) + meter (measure). Triangle = tri (three) + angle. Once you know ten bricks, you can spell (and understand!) a hundred subject words.",
    "ruleExplanation": "Subject vocabulary is built from productive roots: meter (measure), therm (heat), bio (life), geo (earth), tri (three), cent (hundred), poly (many), hydro (water). Spell root-by-root.",
    "watchForCue": "Break the scary word into bricks you know: therm + o + meter. Spell each brick — the word spells itself.",
    "sourceApprovalStatus": "human_approved",
    "sourceReviewerDecision": "approved"
  },
