  "reviewedIntroduction": {
    "title": "Common Latin roots",
    "childFriendlyExplanation": "Two thousand years ago the Romans spoke Latin — and their word-bricks are still inside our words! port = carry (transport, export, import). struct = build (structure, construct). Spot the Roman brick and half the word is spelled.",
    "ruleExplanation": "Latin roots keep stable spelling across word families: port (carry), struct (build), rupt (break), tract (pull), dict (say), scrib/script (write). Spell root as a fixed chunk, then add affixes.",
    "watchForCue": "Find the Roman brick first — port, struct, rupt — spell it as one chunk, then add the front and end parts.",
    "sourceApprovalStatus": "human_approved",
    "sourceReviewerDecision": "approved"
  },
  "reflection": {
    "promptKey": "latin-root-meaning-v1",
    "promptText": "How did the Latin root meaning help you build or understand a word?",
