  "reviewedIntroduction": {
    "title": "Closed compound words",
    "childFriendlyExplanation": "Some words are two whole words glued into one: foot + ball = football, rain + bow = rainbow. Both little words keep ALL their letters — two Keepers, one word.",
    "ruleExplanation": "Closed compounds join two complete base words with no letters lost, even where letters double up at the join: book + keeper = bookkeeper.",
    "watchForCue": "Find BOTH little words first. Spell each one whole, then push them together — nothing falls off at the join.",
    "sourceApprovalStatus": "human_approved",
    "sourceReviewerDecision": "approved"
  },
  "reflection": {
    "promptKey": "closed-compounds-two-bases-v1",
    "promptText": "How do the two smaller words help you spell a closed compound?",
